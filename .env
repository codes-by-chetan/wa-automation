# Server Configuration
PORT=3000
HOST=0.0.0.0

# OpenAI-Compatible LLM Settings (Can also be configured via Web Dashboard)
# Examples:
# OpenAI: https://api.openai.com/v1
# Ollama: http://localhost:11434/v1
# Groq: https://api.groq.com/openai/v1
# DeepSeek: https://api.deepseek.com/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Default System Prompt
SYSTEM_PROMPT="You are a smart, professional, and friendly WhatsApp AI assistant. Provide concise, natural, and helpful replies suitable for chat messaging."
