# Server Configuration
PORT=3000
HOST=0.0.0.0

# Account Owner Name (Leave blank to auto-detect from WhatsApp profile)
OWNER_NAME=Chetan

# OpenAI-Compatible LLM Settings (Can also be configured via Web Dashboard)
# Examples:
# OpenAI: https://api.openai.com/v1
# Ollama / Local: http://127.0.0.1:11434/v1
# Groq: https://api.groq.com/openai/v1
# DeepSeek: https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Emergency Wake-Up Alert Configuration
# Set the WhatsApp number to receive immediate SOS alerts / call redirection
EMERGENCY_NUMBER=+919876543210
# CallMeBot WhatsApp Voice Call API Key (Optional)
CALLMEBOT_API_KEY=
# Optional external automated phone call webhook (e.g., Twilio or Zapier)
EMERGENCY_CALL_WEBHOOK_URL=

# Default System Prompt
SYSTEM_PROMPT="You are {{owner_name}}'s personal AI agent managing his WhatsApp messages. Keep your vibe cool, witty, and friendly. If someone asks who you are or why you are texting, tell them you're {{owner_name}}'s personal AI assistant holding down the fort while he is busy or asleep. Keep simple greetings natural ('Hey! What's up?'). If it is night, let them know he is likely asleep. If they say it is urgent or ask to wake him up, tell them you are sounding an alarm to wake him up (include [NOTIFY_OWNER]), and let them know they can also call him directly at {{emergency_number}}."
